NEXT_PUBLIC_LIVEKIT_WS_URL=ws://187.127.131.34:7880

LIVEKIT_WS_URL=ws://187.127.131.34:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI meeting notes: the host/admin can request transcription + summarization
# of a meeting's recording after it ends (services/meetingNotes.service.ts).
# Recordings are captured by LiveKit Egress (services/egress.service.ts).
# Transcription + summarization/action-items both run locally via the
# ai-notes/ service (FastAPI + faster-whisper + Ollama, see ai-notes/README.md)
# — services/aiNotes.client.ts calls it over HTTP. No audio or transcript text
# ever leaves the server, and no external AI API key is required for notes.
AI_NOTES_SERVICE_URL=http://127.0.0.1:8100
AI_NOTES_SERVICE_TOKEN=change-me   # must match ai-notes/.env's AI_NOTES_SERVICE_TOKEN

# Only used by translateTranscript() (translating an existing transcript into
# another language, app/api/meetings/[id]/notes/translate) — unrelated to the
# transcription/summarization pipeline above.
OPENAI_API_KEY=your_openai_api_key

# Recording storage — 'local' (default) writes recordings to disk instead of
# a cloud bucket, which is fine as long as there's room for them (e.g. a 1TB
# server). RECORDING_LOCAL_DIR must be a directory the Egress service can
# also write to — if Egress runs as a separate process/container, mount the
# same path into both it and this app. Switch to 's3' once you have an
# S3-compatible bucket (e.g. self-hosted MinIO) to upload to instead — that
# also needs the same access key/secret configured on the Egress service's
# own storage.s3 config.
RECORDING_STORAGE_MODE=local
RECORDING_LOCAL_DIR=./recordings

# RECORDING_S3_ENDPOINT=http://your-minio-host:9000
# RECORDING_S3_REGION=us-east-1
# RECORDING_S3_BUCKET=meeting-recordings
# RECORDING_S3_ACCESS_KEY_ID=your_minio_access_key
# RECORDING_S3_SECRET_ACCESS_KEY=your_minio_secret_key

DATABASE_URL="postgresql://user@localhost:5432/confera?schema=public"

# The exact origin OAuth redirect_uris are registered under (Google/Facebook
# require an exact match) — no trailing slash. Used for nothing else.
APP_BASE_URL=http://localhost:3000

# "Continue with Google" / "Continue with Facebook" (app/api/auth/oauth/**).
# Both are optional — leave a pair unset and that provider's button shows a
# clear "not configured" error instead of the rest of auth breaking.
#   Google: console.cloud.google.com → APIs & Services → Credentials →
#     OAuth client ID (Web application). Authorized redirect URI:
#     {APP_BASE_URL}/api/auth/oauth/google/callback
#   Facebook: developers.facebook.com → your app → Facebook Login → Settings.
#     Valid OAuth Redirect URI: {APP_BASE_URL}/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Profile picture storage (lib/avatarStorage.ts) — an S3-compatible bucket,
# separate from the private RECORDING_S3_* one above because avatars are
# rendered directly in <img> tags across the app and so need PUBLIC read
# access (give the bucket/prefix a public-read policy). Used both for a
# manually uploaded picture at registration and for mirroring a Google/
# Facebook profile photo on OAuth sign-in. AVATAR_S3_PUBLIC_URL_BASE is the
# URL prefix a browser can actually reach — e.g. a public bucket URL or a
# CDN domain in front of it — and gets embedded directly in <img src>.
AVATAR_S3_ENDPOINT=http://your-minio-host:9000
AVATAR_S3_REGION=us-east-1
AVATAR_S3_BUCKET=user-avatars
AVATAR_S3_ACCESS_KEY_ID=your_minio_access_key
AVATAR_S3_SECRET_ACCESS_KEY=your_minio_secret_key
AVATAR_S3_PUBLIC_URL_BASE=http://your-minio-host:9000/user-avatars

# Email (SMTP) — sends the one-time passcodes used for email-OTP login and
# for verifying a new account's email during registration (lib/email/mailer.ts).
# Works with any SMTP provider (SES, SendGrid, Postmark, Mailtrap for local
# dev, Gmail with an app password, etc). SMTP_SECURE=true for port 465.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Confera <no-reply@example.com>"

# Bootstrap organization + first admin account, created by `npx prisma db seed`.
# This is the only supported way to create an admin — public registration can
# never select the ADMIN role.
SEED_ORG_NAME="Your Org"
SEED_ORG_SLUG="your-org"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
