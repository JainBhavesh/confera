# Whisper model for transcription. Bigger = more accurate, slower, more RAM.
# tiny/base fit a small VPS; small/medium need more CPU/RAM.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# Ollama server this service calls for summary/action-item extraction, and
# the model to use there (must already be pulled: `ollama pull <name>`).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Shared secret the Next.js app must send as the X-Internal-Token header.
# Required unless this service is bound to 127.0.0.1 only and never reachable
# from outside the host — set the same value here and as AI_NOTES_SERVICE_TOKEN
# in the main app's .env.
AI_NOTES_SERVICE_TOKEN=change-me
